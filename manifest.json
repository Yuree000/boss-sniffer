{
  "manifest_version": 3,
  "name": "BOSS Sniffer",
  "version": "1.0.2",
  "description": "v1.0.2 沟通页浏览数 label 改回「浏览数」(原 v1.0.1 label/placeholder 都是「全部」视觉上像两个 input)；placeholder 保留「全部」。详见 CHANGELOG.md。",
  "permissions": ["storage", "sidePanel", "debugger", "tabs", "permissions", "alarms"],
  "host_permissions": [
    "*://*.zhipin.com/*",
    "https://api.anthropic.com/*",
    "http://10.0.3.248:3000/*",
    "https://api.deepseek.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "BOSS Sniffer · 点击打开侧边栏"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "options_ui": {
    "page": "admin/admin.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["*://*.zhipin.com/*"],
      "js": ["inject.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["*://*.zhipin.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}

{
  "manifest_version": 3,
  "name": "BOSS Sniffer",
  "version": "1.0.0",
  "description": "v1.0.0 首个正式交付版本（沟通页 + 推荐页全链路 / LLM 评估 / 自动话术+求简历 / 自动标不合适 / 看板 / JD 内嵌话术 + 自定义 prompt）。详见 CHANGELOG.md。",
  "permissions": ["storage", "sidePanel", "debugger", "tabs", "permissions", "alarms"],
  "host_permissions": [
    "*://*.zhipin.com/*",
    "https://api.anthropic.com/*",
    "http://10.0.3.248:3000/*",
    "https://api.deepseek.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "BOSS Sniffer · 点击打开侧边栏"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "options_ui": {
    "page": "admin/admin.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["*://*.zhipin.com/*"],
      "js": ["inject.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["*://*.zhipin.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
